---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { createDb } from '../../db/client';
import { env } from 'cloudflare:workers';
import { gateAdmin } from '../../lib/admin-page';
import { listAdminArtikel } from '../../lib/artikel-admin';
import { listBilder } from '../../lib/bilder-admin';

const gated = await gateAdmin(Astro);
if (gated instanceof Response) return gated;

const db = createDb(env.DB);
const { rows, total } = await listAdminArtikel(db, { seite: 1 });
const bilder = await listBilder(db, 5);
const published = rows.filter((r) => r.status === 'veroeffentlicht').length;
const drafts = rows.filter((r) => r.status === 'entwurf').length;
---

<AdminLayout title="Admin | Lemisch">
	<h1 class="font-display text-3xl font-bold text-primary">Dashboard</h1>
	<p class="mt-2 text-muted-foreground">
		Angemeldet{gated.email ? ` als ${gated.email}` : ''} ({gated.via}).
	</p>

	<ul class="mt-8 grid gap-4 sm:grid-cols-3">
		<li class="rounded-md border border-border bg-background p-4">
			<p class="text-sm text-muted-foreground">Artikel gesamt</p>
			<p class="mt-1 font-display text-2xl font-bold text-primary">{total}</p>
		</li>
		<li class="rounded-md border border-border bg-background p-4">
			<p class="text-sm text-muted-foreground">Auf dieser Seite veröffentlicht</p>
			<p class="mt-1 font-display text-2xl font-bold text-primary">{published}</p>
		</li>
		<li class="rounded-md border border-border bg-background p-4">
			<p class="text-sm text-muted-foreground">Entwürfe (Seite)</p>
			<p class="mt-1 font-display text-2xl font-bold text-primary">{drafts}</p>
		</li>
	</ul>

	<div class="mt-8 flex flex-wrap gap-3">
		<a
			href="/admin/artikel/neu/"
			class="inline-flex min-h-11 items-center justify-center rounded-md bg-action px-4 py-2 font-display text-sm font-bold text-action-foreground transition-colors duration-150 hover:bg-action/90 active:bg-action/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
		>
			Neuer Artikel
		</a>
		<a
			href="/admin/artikel/"
			class="inline-flex min-h-11 items-center justify-center rounded-md border border-border bg-background px-4 py-2 text-sm font-medium transition-colors duration-150 hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
		>
			Alle Artikel
		</a>
		<a
			href="/admin/bilder/"
			class="inline-flex min-h-11 items-center justify-center rounded-md border border-border bg-background px-4 py-2 text-sm font-medium transition-colors duration-150 hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
		>
			Bilder ({bilder.length}+)
		</a>
	</div>
</AdminLayout>
