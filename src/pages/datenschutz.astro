---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://example.com';
const title = 'Datenschutz | Lemisch Sanierung & Modernisierung';
const description =
	'Datenschutzerklärung von Lemisch Sanierung & Modernisierung. Rechtstext folgt – Platzhalter.';
---

<BaseLayout
	title={title}
	description={description}
	noindex={true}
	breadcrumbs={[
		{ name: 'Start', url: `${siteUrl}/` },
		{ name: 'Datenschutz', url: `${siteUrl}/datenschutz/` },
	]}
>
	<PageHero eyebrow="Rechtliches" title="Datenschutz" compact />
	<div class="prose-lsm mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<p class="text-sm font-medium text-primary">TODO: Rechtstext ergänzen</p>
		<p>
			Dieser Platzhalter wird durch die vollständige Datenschutzerklärung ersetzt. Bis dahin
			ist die Seite auf noindex gesetzt. Das Kontaktformular verarbeitet Angaben erst, wenn
			der Webhook verbunden ist.
		</p>
	</div>
</BaseLayout>
