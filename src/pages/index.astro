<script>
	const root = document.querySelector<HTMLElement>('[data-typewriter]');
	const output = root?.querySelector<HTMLElement>('[data-typewriter-text]');
	const caret = root?.querySelector<HTMLElement>('[data-typewriter-caret]');

	if (root && output && caret) {
		const phrasen: string[] = JSON.parse(root.dataset.typewriter ?? '[]');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

		const setTyping = (typing: boolean) => {
			caret.style.animation = typing ? 'none' : '';
		};

		const run = async () => {
			let index = 0;
			while (true) {
				await wait(2200);
				const next = (index + 1) % phrasen.length;

				if (reducedMotion.matches) {
					output.textContent = phrasen[next];
				} else {
					setTyping(true);
					const current = phrasen[index];
					for (let i = current.length; i >= 0; i--) {
						output.textContent = current.slice(0, i);
						await wait(30);
					}
					await wait(250);
					const target = phrasen[next];
					for (let i = 1; i <= target.length; i++) {
						output.textContent = target.slice(0, i);
						await wait(55 + Math.random() * 45);
					}
					setTyping(false);
				}
				index = next;
			}
		};

		run();
	}
</script>
