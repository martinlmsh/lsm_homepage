---
interface FaqItem {
	question: string;
	/** Klartext für Schema und Fallback-Anzeige */
	answer: string;
	/** Optional mit Links; wenn gesetzt, wird dies statt answer gerendert */
	answerHtml?: string;
}

interface Props {
	items: FaqItem[];
}

const { items } = Astro.props;

const linkClasses =
	'[&_a]:font-medium [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-4 [&_a]:transition-colors [&_a]:duration-150 hover:[&_a]:text-primary/80 [&_a]:focus-visible:outline-none [&_a]:focus-visible:ring-2 [&_a]:focus-visible:ring-ring [&_a]:focus-visible:ring-offset-2';
---

<ul class="border-b border-border">
	{
		items.map((item) => (
			<li class="border-t border-border">
				<details class="group" name="faq">
					<summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-8 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 [&::-webkit-details-marker]:hidden">
						<h3 class="text-left font-display text-xl font-semibold tracking-tight text-foreground transition-colors duration-150 group-open:text-primary sm:text-2xl">
							{item.question}
						</h3>
						<span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-border text-foreground transition-colors duration-200 ease-out group-open:border-action group-open:bg-action group-open:text-action-foreground">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="h-4 w-4 motion-safe:transition-transform motion-safe:duration-200 group-open:rotate-45"
								aria-hidden="true"
							>
								<path d="M12 5v14M5 12h14" />
							</svg>
						</span>
					</summary>
					{item.answerHtml ? (
						<p
							class:list={[
								'max-w-3xl pb-8 pr-16 text-pretty text-muted-foreground',
								linkClasses,
							]}
							set:html={item.answerHtml}
						/>
					) : (
						<p class="max-w-3xl pb-8 pr-16 text-pretty text-muted-foreground">{item.answer}</p>
					)}
				</details>
			</li>
		))
	}
</ul>
