---
import type { CollectionEntry } from 'astro:content';
import AnfrageSection from './AnfrageSection.astro';
import ArtikelListe from './ArtikelListe.astro';
import ContactLink from './ContactLink.astro';
import Icon from './Icon.astro';
import { formatDatum, typLabel, type ArtikelKarte } from '../lib/artikel';
import type { Artikel, Bild } from '../db/schema';

interface Props {
	entry: Artikel & { titelbild: Bild | null };
	contentHtml: string;
	verwandte: ArtikelKarte[];
	linkedLeistung?: CollectionEntry<'leistungen'>;
	/** In der Vorschau: Datum auch ohne Veröffentlichung zeigen */
	vorschau?: boolean;
}

const { entry, contentHtml, verwandte, linkedLeistung, vorschau = false } = Astro.props;

const published = entry.veroeffentlichtAm ?? entry.aktualisiertAm;
const datum = formatDatum(published) || (vorschau ? 'Vorschau' : '');
const titelbildSrc = entry.titelbild ? `/bilder/${entry.titelbild.r2Key}/` : undefined;
const woerter = entry.inhaltMd.split(/\s+/).filter(Boolean).length;
const lesezeit = Math.max(1, Math.round(woerter / 200));
---

<article>
	<header class="mx-auto max-w-6xl px-4 pt-28 sm:px-6 sm:pt-32">
		<nav aria-label="Brotkrumen" class="text-sm text-muted-foreground">
			<ol class="flex flex-wrap items-center gap-2">
				<li>
					<a
						href="/"
						class="transition-colors duration-150 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
					>
						Start
					</a>
				</li>
				<li aria-hidden="true">/</li>
				<li>
					<a
						href="/wissenswertes/"
						class="transition-colors duration-150 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
					>
						Wissenswertes
					</a>
				</li>
			</ol>
		</nav>

		<p class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted-foreground">
			<span class="rounded-full bg-muted px-3 py-1 font-medium text-foreground">
				{typLabel(entry.typ)}
			</span>
			{datum && <time datetime={published}>{datum}</time>}
			<span aria-hidden="true">·</span>
			<span>{lesezeit} Min. Lesezeit</span>
			{
				entry.ort && (
					<>
						<span aria-hidden="true">·</span>
						<span class="inline-flex items-center gap-1">
							<Icon name="pin" class="h-4 w-4" />
							{entry.ort}
						</span>
					</>
				)
			}
		</p>

		<h1
			class="mt-4 max-w-4xl text-balance font-display text-3xl font-semibold leading-tight tracking-tight text-foreground sm:text-4xl lg:text-5xl"
		>
			{entry.titel}
		</h1>

		{
			entry.teaser && (
				<p class="mt-6 max-w-3xl text-pretty text-lg leading-relaxed text-muted-foreground sm:text-xl">
					{entry.teaser}
				</p>
			)
		}
	</header>

	{
		titelbildSrc && entry.titelbild && (
			<figure class="mx-auto mt-12 max-w-6xl px-4 sm:px-6">
				<img
					src={titelbildSrc}
					alt={entry.titelbild.alt}
					width={entry.titelbild.breite ?? undefined}
					height={entry.titelbild.hoehe ?? undefined}
					loading="eager"
					fetchpriority="high"
					class="aspect-[16/9] w-full rounded-2xl bg-muted object-cover"
				/>
			</figure>
		)
	}

	<div
		class="mx-auto grid max-w-6xl gap-12 px-4 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-16 lg:grid-cols-12 lg:gap-16"
	>
		<div class="prose-artikel lg:col-span-8" set:html={contentHtml} />

		<aside class="lg:col-span-4" aria-label="Kontakt und passende Leistung">
			<div class="space-y-6 lg:sticky lg:top-28">
				<div class="rounded-2xl border border-border p-6">
					<p class="font-display text-lg font-semibold text-foreground">Fragen zu Ihrem Vorhaben?</p>
					<p class="mt-2 text-muted-foreground">
						Rufen Sie mich an – ich berate Sie persönlich und komme gern zu Ihnen vor Ort.
					</p>
					<ContactLink
						type="phone"
						class="mt-4 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-md bg-action px-4 py-2 font-display text-sm font-bold text-action-foreground transition-colors duration-150 hover:bg-action/90 active:bg-action/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
					>
						<Icon name="phone" class="h-4 w-4" />
						<span data-contact-label>Telefon</span>
					</ContactLink>
				</div>

				{
					linkedLeistung && (
						<a
							href={`/${linkedLeistung.id}/`}
							class="group block rounded-2xl bg-muted p-6 transition-colors duration-150 hover:bg-muted/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
						>
							<p class="text-sm text-muted-foreground">Passende Leistung</p>
							<p class="mt-1 font-display text-xl font-semibold text-foreground">
								{linkedLeistung.data.title}
							</p>
							<p class="mt-2 text-muted-foreground">{linkedLeistung.data.kurzbeschreibung}</p>
							<span class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-primary underline underline-offset-4 group-hover:text-primary/80">
								Mehr erfahren
								<Icon name="arrow" class="h-4 w-4" />
							</span>
						</a>
					)
				}
			</div>
		</aside>
	</div>

	<ArtikelListe
		artikel={verwandte}
		eyebrow="Weiterlesen"
		titel="Weitere Artikel"
		headingId="weitere-artikel-heading"
	/>

	<AnfrageSection selectedLeistung={linkedLeistung?.id} />
</article>
