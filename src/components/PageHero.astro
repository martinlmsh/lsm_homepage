---
import BrandMark from './BrandMark.astro';

interface Props {
	eyebrow?: string;
	title: string;
	intro?: string;
	compact?: boolean;
}

const { eyebrow, title, intro, compact = false } = Astro.props;
---

<header class="relative isolate overflow-hidden bg-primary text-primary-foreground">
	<div
		class="pointer-events-none absolute -left-24 top-16 -z-10 h-72 w-72 rounded-full bg-action/15 blur-3xl"
		aria-hidden="true"
	>
	</div>
	<BrandMark
		class="pointer-events-none absolute -right-16 -bottom-24 -z-10 h-96 w-96 text-primary-foreground/5 sm:-right-8"
	/>

	<div class:list={['mx-auto max-w-6xl px-4 sm:px-6', compact ? 'pb-12 pt-32' : 'pb-16 pt-36 sm:pb-24 sm:pt-44']}>
		{
			eyebrow && (
				<p class="inline-flex items-center gap-2 rounded-full border border-primary-foreground/15 bg-primary-foreground/5 px-3 py-1 text-xs font-medium text-primary-foreground/80">
					<span class="h-1.5 w-1.5 rounded-full bg-action" aria-hidden="true" />
					{eyebrow}
				</p>
			)
		}
		<h1
			class="mt-6 max-w-3xl text-balance font-display text-4xl font-semibold leading-tight tracking-tight text-primary-foreground sm:text-5xl"
		>
			{title}
		</h1>
		{
			intro && (
				<p class="mt-6 max-w-2xl text-pretty text-lg text-primary-foreground/70">{intro}</p>
			)
		}
		<slot />
	</div>
</header>
