# Öffentliche Site-URL (ohne trailing slash empfohlen)
# TODO: Domain setzen, sobald sie feststeht
SITE_URL=https://example.com

# n8n- oder anderer Lead-Webhook (öffentliche Client-URL)
# Leer lassen: Formular zeigt „Formular noch nicht verbunden – bitte anrufen“
PUBLIC_LEAD_WEBHOOK_URL=

# --- Admin / Wissenswertes Backend ---
# Lokal (wrangler .dev.vars oder hier): Bearer-/Cookie-Bypass
ADMIN_DEV_TOKEN=local-dev-token-aendern

# Produktion (Cloudflare Access) – Worker Secrets:
# CF_ACCESS_TEAM_DOMAIN=ihr-team.cloudflareaccess.com
# CF_ACCESS_AUD=<Application Audience Tag aus Access>
